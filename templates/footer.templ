package templates

import "fmt"

type FooterData struct {
	TechStack        []string
	CurrentYear      int
	FormAction       string
	QuickLinks       []Link
	SocialLinks      []Link
	CodingProfiles   []Link
	MoreProfiles     []Link
}

templ FooterSection(data FooterData) {
	<footer class="relative overflow-hidden bg-gradient-to-br from-gray-950 via-gray-950/95 to-gray-950/90 border-t border-gray-800/50">
		<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="py-12 lg:py-16">
				<!-- Profile Info & Contact Form Section -->
				<section class="grid gap-10 lg:grid-cols-2 items-stretch mb-12">
					<!-- Profile Info -->
					<div class="flex flex-col h-full justify-between text-center lg:text-left">
						<div class="flex items-center justify-center lg:justify-start space-x-4 mb-6">
							<div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-cyan-500 flex items-center justify-center shadow-lg border border-emerald-500/20">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-white">
									<polyline points="16 18 22 12 16 6"></polyline>
									<polyline points="8 6 2 12 8 18"></polyline>
								</svg>
							</div>
							<h3 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-gray-100 to-emerald-500 bg-clip-text text-transparent">
								Shardendu Mishra
							</h3>
						</div>
						<p class="text-gray-400 text-base lg:text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0">
							Software Engineer engineering innovative and absolutely
						</p>
						<p class="text-gray-400 text-base lg:text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0 mb-6">
							awesome solutions and giving amazing user experiences.
						</p>
						<div class="flex items-center justify-center lg:justify-start space-x-3 text-sm text-gray-400 mb-6">
							<span>Made with</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-red-500 animate-pulse">
								<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
							</svg>
							<span>and</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-amber-600">
								<path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
								<path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
								<line x1="6" y1="1" x2="6" y2="4"></line>
								<line x1="10" y1="1" x2="10" y2="4"></line>
								<line x1="14" y1="1" x2="14" y2="4"></line>
							</svg>
							<span>by Shardendu</span>
						</div>
						<div class="inline-flex flex-wrap items-center justify-center lg:justify-start gap-2 mb-6">
							for _, tech := range data.TechStack {
								<span class="px-2.5 py-1 rounded-full border border-emerald-500/20 bg-emerald-500/10 text-[11px] font-medium tracking-wide text-emerald-500">
									{ tech }
								</span>
							}
						</div>
						<div class="flex items-center justify-center lg:justify-start space-y-2 lg:space-y-0 lg:space-x-6 flex-col lg:flex-row">
							<div class="text-center lg:text-left">
								<p class="text-sm text-gray-400">
									© { fmt.Sprintf("%d", data.CurrentYear) } Shardendu Mishra. All rights reserved.
								</p>
								<p class="text-xs text-gray-400">
									<span class="inline-flex items-center gap-1 font-semibold text-2xl">
										Made with Go in mind and Linux in Kernel.
									</span>
								</p>
							</div>
						</div>
					</div>
					<!-- Contact Form -->
					<div class="flex flex-col h-full">
						<div class="relative flex flex-col flex-1 bg-gradient-to-br from-gray-950/60 via-gray-900/30 to-gray-900/10 border border-gray-800/40 rounded-2xl backdrop-blur-lg p-8 shadow-lg transition-all duration-300">
							<span class="absolute inset-x-4 top-0 h-0.5 rounded-full bg-gradient-to-r from-emerald-500 via-cyan-500 to-emerald-500"></span>
							<div class="flex items-center gap-3 mb-6">
								<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/90 shadow-inner">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-white">
										<rect width="20" height="16" x="2" y="4" rx="2"></rect>
										<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
									</svg>
								</div>
								<h3 class="text-xl font-semibold tracking-tight text-gray-100">Let's Talk</h3>
							</div>
							<form method="POST" action={ templ.URL(data.FormAction) } class="flex flex-col flex-1 space-y-6">
								<div class="grid gap-4 md:grid-cols-2">
									<input type="text" name="name" placeholder="Full name" required class="h-12 rounded-lg bg-gray-950/80 border border-gray-800/50 px-4 text-sm text-gray-100 placeholder-gray-500 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/40 outline-none"/>
									<input type="email" name="email" placeholder="Email address" required class="h-12 rounded-lg bg-gray-950/80 border border-gray-800/50 px-4 text-sm text-gray-100 placeholder-gray-500 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/40 outline-none"/>
								</div>
								<textarea name="message" rows="5" placeholder="Share details or say hello…" required class="min-h-[120px] w-full resize-none rounded-lg bg-gray-950/80 border border-gray-800/50 px-4 py-3 text-sm text-gray-100 placeholder-gray-500 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/40 outline-none"></textarea>
								<div class="mt-auto">
									<button type="submit" class="h-12 w-full rounded-lg bg-gradient-to-r from-emerald-500 to-cyan-500 text-white font-semibold shadow-md hover:from-emerald-600 hover:to-cyan-600 transition-all duration-300 flex items-center justify-center gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
											<path d="m22 2-7 20-4-9-9-4Z"></path>
											<path d="M22 2 11 13"></path>
										</svg>
										Send message
									</button>
								</div>
							</form>
						</div>
					</div>
				</section>
				<!-- Back to Top Button -->
				<div class="flex justify-center mb-8">
					<button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="group flex items-center space-x-2 px-4 py-2 bg-gray-900/50 hover:bg-emerald-500/10 border border-gray-800/50 hover:border-emerald-500/30 rounded-full transition-all duration-300 shadow-lg">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-emerald-500 group-hover:scale-110 transition-transform">
							<path d="m18 15-6-6-6 6"></path>
						</svg>
						<span class="text-sm font-medium text-gray-100 group-hover:text-emerald-500">Back to top</span>
					</button>
				</div>
				<div class="h-px w-full bg-gradient-to-r from-transparent via-gray-800/50 to-transparent mb-12"></div>
				<!-- Links Grid -->
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-12 mb-12">
					<!-- Quick Links -->
					<div class="space-y-4 lg:space-y-6">
						<h4 class="text-base lg:text-lg font-semibold text-gray-100 flex items-center space-x-2 justify-center lg:justify-start">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 lg:w-5 h-4 lg:h-5 text-emerald-500">
								<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
							</svg>
							<span>Quick Links</span>
						</h4>
						<ul class="space-y-2 text-center lg:text-left">
							for _, link := range data.QuickLinks {
								<li><a href={ templ.URL(link.URL) } class="text-sm text-gray-400 hover:text-emerald-500 transition-colors">{ link.Name }</a></li>
							}
						</ul>
					</div>
					<!-- Social Media -->
					<div class="space-y-4 lg:space-y-6">
						<h4 class="text-base lg:text-lg font-semibold text-gray-100 flex items-center space-x-2 justify-center lg:justify-start">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 lg:w-5 h-4 lg:h-5 text-cyan-500">
								<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
							</svg>
							<span>Social Media</span>
						</h4>
						<ul class="space-y-2 text-center lg:text-left">
							for _, link := range data.SocialLinks {
								<li><a href={ templ.URL(link.URL) } target="_blank" class="text-sm text-gray-400 hover:text-cyan-500 transition-colors">{ link.Name }</a></li>
							}
						</ul>
					</div>
					<!-- Coding Profiles -->
					<div class="space-y-4 lg:space-y-6">
						<h4 class="text-base lg:text-lg font-semibold text-gray-100 flex items-center space-x-2 justify-center lg:justify-start">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 lg:w-5 h-4 lg:h-5 text-blue-500">
								<polyline points="16 18 22 12 16 6"></polyline>
								<polyline points="8 6 2 12 8 18"></polyline>
							</svg>
							<span>Coding Profiles</span>
						</h4>
						<ul class="space-y-2 text-center lg:text-left">
							for _, link := range data.CodingProfiles {
								<li><a href={ templ.URL(link.URL) } target="_blank" class="text-sm text-gray-400 hover:text-blue-500 transition-colors">{ link.Name }</a></li>
							}
						</ul>
					</div>
					<!-- More Profiles -->
					<div class="space-y-4 lg:space-y-6">
						<h4 class="text-base lg:text-lg font-semibold text-gray-100 flex items-center space-x-2 justify-center lg:justify-start">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 lg:w-5 h-4 lg:h-5 text-purple-500">
								<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
							</svg>
							<span>More Profiles</span>
						</h4>
						<ul class="space-y-2 text-center lg:text-left">
							for _, link := range data.MoreProfiles {
								<li><a href={ templ.URL(link.URL) } target="_blank" class="text-sm text-gray-400 hover:text-purple-500 transition-colors">{ link.Name }</a></li>
							}
						</ul>
					</div>
				</div>
				<!-- Bottom Bar -->
				<div class="flex justify-center pb-8">
					<div class="w-24 h-1 bg-gradient-to-r from-emerald-500 to-cyan-500 rounded-full"></div>
				</div>
			</div>
		</div>
	</footer>
}
