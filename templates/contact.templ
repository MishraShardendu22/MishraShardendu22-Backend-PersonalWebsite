package templates

import "fmt"

type Link struct {
	Name string
	URL  string
}

type ContactCommit struct {
	Message string
	Date    string
	Repo    string
}

type ContactData struct {
	GitHubAvatar     string
	GitHubUsername   string
	GitHubBio        string
	GitHubRepos      int
	GitHubFollowers  int
	TotalStars       int
	LeetCodeEasy     int
	LeetCodeMedium   int
	LeetCodeHard     int
	LeetCodeTotal    int
	RecentCommits    []ContactCommit
	Technologies     []string
}

templ ContactSection(data ContactData) {
	<section class="min-h-screen bg-gradient-to-br from-background via-background to-muted p-4 pb-20">
		<div class="max-w-7xl mx-auto">
			<div class="text-center mb-12">
				<h1 class="text-4xl lg:text-5xl font-bold mb-4">
					<span class="bg-gradient-to-r from-emerald-500 to-cyan-500 bg-clip-text text-transparent">
						Developer Dashboard
					</span>
				</h1>
				<p class="text-muted-foreground text-lg">Real-time statistics and activity overview</p>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<div class="bg-card border border-border rounded-2xl p-6 backdrop-blur-sm hover:border-emerald-500/30 transition-all duration-300">
					<div class="flex items-center justify-between mb-6">
						<h3 class="text-xl font-bold text-emerald-500">GitHub Profile</h3>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500">
							<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
							<path d="M9 18c-4.51 2-5-2-7-2"></path>
						</svg>
					</div>
					<div class="space-y-4">
						<div class="flex items-center space-x-4">
							<img src={ data.GitHubAvatar } alt="GitHub Avatar" class="w-16 h-16 rounded-full border-2 border-emerald-500/30"/>
							<div>
								<p class="font-semibold text-lg text-card-foreground">{ data.GitHubUsername }</p>
								<p class="text-sm text-muted-foreground">{ data.GitHubBio }</p>
							</div>
						</div>
						<div class="grid grid-cols-3 gap-4 pt-4">
							<div class="text-center">
								<p class="text-2xl font-bold text-emerald-500">{ templ.EscapeString(fmt.Sprintf("%d", data.GitHubRepos)) }</p>
								<p class="text-xs text-muted-foreground">Repositories</p>
							</div>
							<div class="text-center">
								<p class="text-2xl font-bold text-emerald-500">{ templ.EscapeString(fmt.Sprintf("%d", data.GitHubFollowers)) }</p>
								<p class="text-xs text-muted-foreground">Followers</p>
							</div>
							<div class="text-center">
								<p class="text-2xl font-bold text-emerald-500">{ templ.EscapeString(fmt.Sprintf("%d", data.TotalStars)) }</p>
								<p class="text-xs text-muted-foreground">Stars</p>
							</div>
						</div>
					</div>
				</div>
				<!-- LeetCode Stats Card -->
				<div class="bg-card border border-border rounded-2xl p-6 backdrop-blur-sm hover:border-cyan-500/30 transition-all duration-300">
					<div class="flex items-center justify-between mb-6">
						<h3 class="text-xl font-bold text-cyan-500">LeetCode Stats</h3>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-500">
							<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
						</svg>
					</div>
					<div class="grid grid-cols-2 gap-4">
						<div class="bg-green-500/10 rounded-xl p-4 border border-green-500/20">
							<p class="text-3xl font-bold text-green-500">{ templ.EscapeString(fmt.Sprintf("%d", data.LeetCodeEasy)) }</p>
							<p class="text-sm text-muted-foreground mt-1">Easy</p>
						</div>
						<div class="bg-yellow-500/10 rounded-xl p-4 border border-yellow-500/20">
							<p class="text-3xl font-bold text-yellow-500">{ templ.EscapeString(fmt.Sprintf("%d", data.LeetCodeMedium)) }</p>
							<p class="text-sm text-muted-foreground mt-1">Medium</p>
						</div>
						<div class="bg-red-500/10 rounded-xl p-4 border border-red-500/20">
							<p class="text-3xl font-bold text-red-500">{ templ.EscapeString(fmt.Sprintf("%d", data.LeetCodeHard)) }</p>
							<p class="text-sm text-muted-foreground mt-1">Hard</p>
						</div>
						<div class="bg-cyan-500/10 rounded-xl p-4 border border-cyan-500/20">
							<p class="text-3xl font-bold text-cyan-500">{ templ.EscapeString(fmt.Sprintf("%d", data.LeetCodeTotal)) }</p>
							<p class="text-sm text-muted-foreground mt-1">Total</p>
						</div>
					</div>
				</div>
				<!-- Contact Form -->
				<div class="bg-card border border-border rounded-2xl p-6 backdrop-blur-sm hover:border-blue-500/30 transition-all duration-300">
					<h3 class="text-xl font-bold text-blue-500 mb-6 flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
							<rect width="20" height="16" x="2" y="4" rx="2"></rect>
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
						</svg>
						Get In Touch
					</h3>
					<form id="contactForm" class="space-y-4" onsubmit="return sendEmail(event)">
						<div>
							<label for="name" class="block text-sm font-medium text-foreground mb-2">Your Name</label>
							<input 
								type="text" 
								id="name" 
								name="name" 
								required
								class="w-full px-4 py-2 bg-input border border-border rounded-lg focus:ring-2 focus:ring-ring focus:border-transparent text-foreground placeholder-muted-foreground transition-all"
								placeholder="John Doe"
							/>
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-foreground mb-2">Your Email</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								required
								class="w-full px-4 py-2 bg-input border border-border rounded-lg focus:ring-2 focus:ring-ring focus:border-transparent text-foreground placeholder-muted-foreground transition-all"
								placeholder="john@example.com"
							/>
						</div>
						<div>
							<label for="message" class="block text-sm font-medium text-foreground mb-2">Message</label>
							<textarea 
								id="message" 
								name="message" 
								rows="4" 
								required
								class="w-full px-4 py-2 bg-input border border-border rounded-lg focus:ring-2 focus:ring-ring focus:border-transparent text-foreground placeholder-muted-foreground transition-all resize-none"
								placeholder="Your message here..."
							></textarea>
						</div>
						<button 
							type="submit"
							class="w-full bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-600 hover:to-cyan-600 text-white font-semibold py-3 rounded-lg transition-all duration-300 transform hover:scale-[1.02] flex items-center justify-center space-x-2"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="m22 2-7 20-4-9-9-4Z"></path>
								<path d="M22 2 11 13"></path>
							</svg>
							<span>Send Message</span>
						</button>
					</form>
					<script>
						function sendEmail(event) {
							event.preventDefault();
							
							const name = document.getElementById('name').value;
							const email = document.getElementById('email').value;
							const message = document.getElementById('message').value;
							
							const subject = encodeURIComponent(`Portfolio Contact from ${name}`);
							const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`);
							
							window.location.href = `mailto:shardendumishra01@gmail.com?subject=${subject}&body=${body}`;
							
							return false;
						}
					</script>
				</div>
				<!-- Technology Stack -->
				<div class="bg-card border border-border rounded-2xl p-6 backdrop-blur-sm hover:border-purple-500/30 transition-all duration-300">
					<h3 class="text-xl font-bold text-purple-500 mb-6">Technology Stack</h3>
					<div class="flex flex-wrap gap-2">
						for _, tech := range data.Technologies {
							<span class="px-3 py-1 bg-purple-500/10 border border-purple-500/20 rounded-full text-sm text-purple-400">
								{ tech }
							</span>
						}
					</div>
				</div>
			</div>
		</div>
	</section>
}
