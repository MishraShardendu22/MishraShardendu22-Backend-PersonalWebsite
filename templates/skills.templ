package templates

import "fmt"

type SkillsData struct {
	StartIndex  int
	EndIndex    int
	TotalSkills int
	Skills      []string
	CurrentPage int
	TotalPages  int
}

templ SkillsSection(data SkillsData) {
	<section class="relative py-8 sm:py-12 lg:py-16 overflow-hidden bg-background">
		<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<!-- Header -->
			<div class="mx-auto max-w-2xl text-center">
				<div class="mb-4 sm:mb-6 inline-block px-3 py-1.5 sm:px-4 sm:py-2 bg-card/80 backdrop-blur-sm border border-primary/30 rounded-full hover:border-primary/50 transition-colors">
					<div class="flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-3 w-3 sm:h-4 sm:w-4 text-primary">
							<polyline points="16 18 22 12 16 6"></polyline>
							<polyline points="8 6 2 12 8 18"></polyline>
						</svg>
						<span class="text-xs sm:text-sm text-foreground">Technical Expertise</span>
					</div>
				</div>
				<br/>
				<div class="relative inline-block">
					<h2 class="text-2xl sm:text-4xl lg:text-6xl font-bold tracking-tight mb-2">
						<span class="text-foreground">Technical </span>
						<span class="text-primary">Skills</span>
					</h2>
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute -top-0.5 -right-6 sm:-right-12 h-4 w-4 sm:h-6 sm:w-6 text-secondary animate-pulse">
						<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
					</svg>
				</div>
				<p class="mt-4 sm:mt-8 text-sm sm:text-lg leading-6 sm:leading-8 text-muted-foreground max-w-xs sm:max-w-lg mx-auto px-4 sm:px-0">
					Technologies and tools I work with to bring ideas to life
				</p>
				<div class="mt-3 sm:mt-4 text-xs sm:text-sm text-muted-foreground">
					Showing { fmt.Sprintf("%d-%d of %d skills", data.StartIndex, data.EndIndex, data.TotalSkills) }
				</div>
			</div>
			<!-- Skills Grid -->
			<div class="mx-auto mt-8 sm:mt-16 lg:mt-20 max-w-6xl">
				<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2 sm:gap-3 lg:gap-4">
					for _, skill := range data.Skills {
						<div class="group relative">
							<div class="relative w-full justify-center py-2 sm:py-3 px-2 sm:px-4 text-xs sm:text-sm font-medium transition-all duration-300 hover:scale-105 cursor-default bg-accent/10 hover:bg-accent/20 text-foreground border border-accent/20 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/10 min-h-[2.5rem] sm:min-h-[3rem] flex items-center rounded-lg">
								<span class="relative z-10 text-foreground group-hover:text-foreground text-center leading-tight">
									{ skill }
								</span>
							</div>
							<div class="absolute inset-0 rounded-lg bg-gradient-to-r from-primary/10 to-secondary/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10"></div>
						</div>
					}
				</div>
			</div>
			<!-- Pagination Controls -->
			if data.TotalPages > 1 {
				<div class="mt-8 sm:mt-12 flex justify-center items-center gap-2 sm:gap-4">
					<!-- Previous Button -->
					if data.CurrentPage > 1 {
						<a 
							href={ templ.URL(fmt.Sprintf("/?skills_page=%d#skills", data.CurrentPage-1)) }
							class="group flex items-center gap-2 px-3 sm:px-4 py-2 bg-card border border-primary/30 hover:border-primary/60 rounded-lg transition-all duration-300 hover:scale-105"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
								<polyline points="15 18 9 12 15 6"></polyline>
							</svg>
							<span class="text-xs sm:text-sm text-foreground">Previous</span>
						</a>
					} else {
						<div class="flex items-center gap-2 px-3 sm:px-4 py-2 bg-card/50 border border-border rounded-lg opacity-50 cursor-not-allowed">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
								<polyline points="15 18 9 12 15 6"></polyline>
							</svg>
							<span class="text-xs sm:text-sm text-muted-foreground">Previous</span>
						</div>
					}
					<!-- Page Numbers -->
					<div class="flex items-center gap-1 sm:gap-2">
						for i := 1; i <= data.TotalPages; i++ {
							if i == data.CurrentPage {
								<div class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center bg-primary text-background rounded-lg font-semibold text-xs sm:text-sm">
									{ fmt.Sprintf("%d", i) }
								</div>
							} else {
								<a 
									href={ templ.URL(fmt.Sprintf("/?skills_page=%d#skills", i)) }
									class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center bg-card hover:bg-accent/20 border border-border hover:border-primary/40 rounded-lg transition-all duration-300 hover:scale-105 text-xs sm:text-sm text-foreground"
								>
									{ fmt.Sprintf("%d", i) }
								</a>
							}
						}
					</div>
					<!-- Next Button -->
					if data.CurrentPage < data.TotalPages {
						<a 
							href={ templ.URL(fmt.Sprintf("/?skills_page=%d#skills", data.CurrentPage+1)) }
							class="group flex items-center gap-2 px-3 sm:px-4 py-2 bg-card border border-primary/30 hover:border-primary/60 rounded-lg transition-all duration-300 hover:scale-105"
						>
							<span class="text-xs sm:text-sm text-foreground">Next</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</a>
					} else {
						<div class="flex items-center gap-2 px-3 sm:px-4 py-2 bg-card/50 border border-border rounded-lg opacity-50 cursor-not-allowed">
							<span class="text-xs sm:text-sm text-muted-foreground">Next</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</div>
					}
				</div>
			}
			<div class="mt-12 sm:mt-20 flex justify-center">
				<div class="w-16 sm:w-24 h-0.5 bg-gradient-to-r from-primary to-secondary rounded-full opacity-60"></div>
			</div>
		</div>
	</section>
}
